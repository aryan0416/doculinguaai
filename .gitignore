# ==============================================================================
# DocuLinguaAI Git Ignore Rules
# ==============================================================================

# Python Virtual Environments
venv/
env/
ENV/
.env/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/
share/
pyvenv.cfg

# Python Bytecode & Cache Files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyc
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases & Runtime Data
*.db
*.sqlite
*.sqlite3
backend/doculingua.db
doculingua.db

# Environment & Secret Files
.env
.env.local
.env.*.local
*.env

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Code Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# NLP / Machine Learning Cache & Models
.cache/
models/*
!models/.gitkeep
data/*
!data/.gitkeep
notebooks/.ipynb_checkpoints/
