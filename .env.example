# ==============================================================================
# DocuLinguaAI Environment Variables Configuration
# ==============================================================================

# --- OCR Engine Configuration ---
# Optional on Linux/macOS if tesseract is in PATH.
# On Windows, specify full path to tesseract.exe if not in PATH.
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Groq Cloud LLM Configuration ---
# Required for AI Summarization, Grounded Q&A, and Interactive Quiz Generation.
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_QA_MODEL=llama3-70b-8192

# --- Google OAuth 2.0 Authentication ---
# Required for user authentication via Google Identity Services.
# Configure at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- JWT Token Configuration ---
# Secret key used to sign and verify JSON Web Tokens (JWT).
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_signing_key_here_at_least_32_chars

# --- Application Server & Security Settings ---
# Comma-separated list of allowed CORS origins for the frontend.
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Network and processing timeout in seconds
REQUEST_TIMEOUT=30

# Maximum allowed document upload file size in bytes (Default: 50MB)
MAX_FILE_SIZE=52428800

